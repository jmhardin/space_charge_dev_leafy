   "source": [
    "import numpy as np\n",
    "\n",
    "def step_ensemble(pos):\n",
    "    force = np.zeros((len(pos),3))\n",
    "    vec = np.subtract.outer(pos,pos)\n",
    "    dist = np.inner(vec,vec)\n",
    "    print(dist)\n",
    "    return 0\n",
    "\n",
    "pos = np.random.normal(size=(1000,3))\n",
    "print(pos)\n",
    "print(step_ensemble(pos))"
